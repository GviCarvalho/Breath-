// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

// SQLite for now - this is still a prototype with no real deployed database
// to preserve, and it means local dev needs nothing installed (no Docker,
// no VM) beyond Node itself. The schema here is simple enough that moving
// back to Postgres later, if/when this actually ships, is a small change.
datasource db {
  provider = "sqlite"
}

model User {
  id                String   @id @default(cuid())
  provider          String   // "google", "discord", or "local" (email+password)
  providerAccountId String?  // User's ID from OAuth provider; null for local accounts
  email             String?  @unique // local accounts only; OAuth accounts don't need it
  passwordHash      String?  // local accounts only
  displayName       String
  avatarUrl         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([provider, providerAccountId])
  @@map("users")
}

// Optional: For tracking sessions if using stateful sessions
// For stateless JWT, this table might not be needed in this PR
model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@map("auth_sessions")
}
